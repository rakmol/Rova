{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --no-audit --no-fund --prefix ../..",
  "buildCommand": "npm run build --workspace @rova/api --prefix ../..",
  "functions": {"api/index.ts": {"maxDuration": 60}},
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}],
  "crons": [{"path": "/internal/maintenance", "schedule": "15 2 * * *"}]
}
