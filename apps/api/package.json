{
  "name": "@rova/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:grant": "node --env-file-if-exists=.env --import tsx src/admin-grant.ts",
    "accounts:maintenance": "node --env-file-if-exists=.env --import tsx src/account-maintenance.ts",
    "incidents:maintenance": "node --env-file-if-exists=.env --import tsx src/incident-maintenance.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db-cli.ts migrate",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/db-cli.js migrate",
    "db:seed:demo": "node --env-file-if-exists=.env --import tsx src/db-cli.ts seed-demo",
    "data:roads": "node --env-file-if-exists=.env --import tsx src/osm-road-cli.ts",
    "data:reported-roads": "node --env-file-if-exists=.env --import tsx src/reported-road-cli.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsx --test --test-concurrency=2 src/*.test.ts",
    "test:db": "tsx --test src/db.integration.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "admin:maintenance": "node --env-file-if-exists=.env --import tsx src/admin-maintenance.ts",
    "notifications:work": "node --env-file-if-exists=.env --import tsx src/notification-maintenance.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@rova/shared": "*",
    "@supabase/supabase-js": "^2.119.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
