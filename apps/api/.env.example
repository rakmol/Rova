PORT=4000
NODE_ENV=development
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Empty means forwarded IP headers are not trusted. Use explicit proxy IPs/CIDRs only.
TRUST_PROXY_CIDRS=
RATE_LIMIT_MAX=120
COMPLIANCE_ALERTS_ENABLED=true
COMPLIANCE_TRANSITIONS_ENABLED=true
COMPLIANCE_CORRIDORS_ENABLED=true
REPORTED_ROAD_ALERTS_ENABLED=true
DATABASE_URL=postgres://rova:rova_local_only@localhost:54329/rova
ROVA_ADMIN_IMPORT_TOKEN=
# Optional, explicit local demo seeding. Never enable in production.
ALLOW_SYNTHETIC_SEED=false
# Disposable local rova_test_* database only; integration tests otherwise skip.
TEST_DATABASE_URL=

# Street and landmark search; server only. Never use EXPO_PUBLIC_ for this key.
PLACES_PROVIDER=geoapify
GEOAPIFY_API_KEY=
# Server-only random 32+ character key. Replicas must share it; keep out of client bundles.
PLACES_STORAGE_SIGNING_KEY=
# Stable accounting scope across all replicas; never change to bypass counters.
PROVIDER_USAGE_SCOPE=rova
PROVIDER_SEARCH_MONTHLY_LIMIT=31000
PROVIDER_ROUTING_MONTHLY_LIMIT=9300
PROVIDER_GEOAPIFY_RPS=5
PLACES_DAILY_REQUEST_BUDGET=1000

# Maximum reserved routing upstream requests per UTC day, shared through PostgreSQL.
# Each uncached comparison reserves 3 requests for the documented route preferences.
ROUTING_DAILY_REQUEST_BUDGET=300

# Server-only incident privacy credential, random 32+ characters.
# Production reporting fails closed without a stable hash key.
INCIDENT_IP_HASH_KEY=
# Legacy automated-test credential only; real moderation requires an active reviewer/administrator dashboard role.
ROVA_INCIDENT_MODERATOR_TOKEN=

# Optional driver sign-in, server only. Leave all blank until a dedicated ROVA project exists.
# Enable email OTP and configure an email sender in Supabase before production use.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional coarse unmatched-area request counters, no device/user IDs or precise fixes.
# Disabled by default. Run admin:maintenance daily for 30-day retention when enabled.
ADMIN_COVERAGE_AGGREGATION_ENABLED=false

# Only explicitly reviewed sources with redistribution/offline rights may enter offline exports.
# Published/verified serving checks still apply. No camera locations are inferred/exported.
OFFLINE_SAFETY_ENABLED=false
OFFLINE_SAFETY_SOURCE_IDS=
# Optional notifications: leave disabled until Firebase/FCM and Expo enhanced push security are configured.
PUSH_DELIVERY_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
NOTIFICATION_TOKEN_KEY=
NOTIFICATION_TOKEN_KEY_ID=push-v1
