# Public Mapbox access token (pk.*); it is included in the mobile binary and is not a secret.
# Never use an sk.* token here. Create a separate token for development and production.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Keep disabled until traffic data coverage and ETA quality are verified in Ghana.
EXPO_PUBLIC_MAPBOX_TRAFFIC_ENABLED=false

# Optional full HTTPS URL to your ROVA backend /v1/places/search endpoint.
# Configure MAPBOX_PLACES_ACCESS_TOKEN only on that server, never in this file.
EXPO_PUBLIC_PLACES_PROXY_URL=
# Set geoapify once the backend key and HTTPS endpoint are configured.
# Leave mapbox to keep the existing address-only search during setup.
EXPO_PUBLIC_PLACES_PROVIDER=mapbox
# Legacy client flag; it grants no storage permission and is ignored.
# Storage requires backend-confirmed rights and a signed receipt. Direct Mapbox is temporary.
EXPO_PUBLIC_PLACES_PERMANENT_STORAGE=false

# Production routing: full HTTPS URL ending in /routes.
# In development the existing Expo HTTPS tunnel can provide /rova-api/routes automatically.
EXPO_PUBLIC_ROUTES_API_URL=

# Verified driver-compliance data only; public HTTPS backend endpoint in production.
EXPO_PUBLIC_COMPLIANCE_API_URL=
EXPO_PUBLIC_COMPLIANCE_ALERTS_ENABLED=true
EXPO_PUBLIC_COMPLIANCE_TRANSITIONS_ENABLED=true
EXPO_PUBLIC_COMPLIANCE_CORRIDORS_ENABLED=true
EXPO_PUBLIC_REPORTED_ROAD_ALERTS_ENABLED=true

# Full HTTPS production URL ending in /v1/incidents; development uses the Expo tunnel.
EXPO_PUBLIC_INCIDENTS_API_URL=

# Optional account API root (HTTPS origin), not a Supabase key. Dev uses the Expo tunnel.
EXPO_PUBLIC_ACCOUNT_API_URL=

# Full HTTPS /safety/offline-pack URL; no provider key. Dev uses the Expo tunnel.
EXPO_PUBLIC_OFFLINE_SAFETY_API_URL=
# Optional remote notifications. Local reminders do not need Firebase.
EXPO_PUBLIC_NOTIFICATIONS_API_URL=
# Optional local path / EAS file variable for Android Firebase client configuration; never a service-account private key.
GOOGLE_SERVICES_JSON=
