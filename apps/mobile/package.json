{
  "name": "@rova/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@rnmapbox/maps": "10.3.17",
    "@rnmapbox/navigation": "0.1.2",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-glass-effect": "~58.0.5",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "@expo/ngrok": "^4.1.0"
  },
  "scripts": {
    "postinstall": "node scripts/namespace-maplibre-codegen.cjs",
    "start": "expo start --dev-client",
    "test": "jest --watch=false --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "localization:check": "node scripts/check-localization.cjs --release",
    "eas-build-pre-install": "node ../../scripts/check-toolchain.mjs && node scripts/check-localization.cjs && node ../../scripts/check-release-config.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts",
      "<rootDir>/src/__tests__/**/*.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/private-storage.cjs"
    ]
  },
  "private": true
}
